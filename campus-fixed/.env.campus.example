# Local development only. Export these variables or use an explicit env loader.
# This file is not production configuration and is not loaded automatically.
CAMPUS_ENV=development
CAMPUS_DEV_AUTH=true
CAMPUS_DEMO=false
CAMPUS_DATA_DIR=.campus-data
CAMPUS_ADMIN_EMAILS=demo-admin@tju.edu.cn
CAMPUS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
CAMPUS_EMBEDDED_WORKER=true
CAMPUS_WORKER_DELAY_SECONDS=20
CAMPUS_PUBLIC_API_DOCS=true
# Shared source interval in seconds (300..86400); Cloud Run materials use 1800.
CAMPUS_SOURCE_REFRESH_SECONDS=21600

# Optional private push; UUID -> exclusive public HTTPS gateway URL list.
# Use real login user.id only after the recipient confirms the private destination.
# Example (placeholders only):
# CAMPUS_PUSH_USER_ENDPOINTS={"11111111-1111-4111-8111-111111111111":["https://push.example.invalid/users/student-a"]}
CAMPUS_PUSH_USER_ENDPOINTS={}
# CAMPUS_PUSH_ENDPOINTS is obsolete and ignored. No Apprise dependency is needed.
# No safe binding: UI unavailable; opting into push returns 409 PUSH_NOT_READY.
# Both API and worker must receive the same mapping and restart after changes.

# Production, SMTP, authorized feeds and cloud storage:
# deploy/campus/.env.example

# Hosted single-port launcher (serve_cloud.py). Cloud sandbox defaults only;
# app.py stays the public production entry and is unchanged by these values.
# CAMPUS_CLOUD_MODE=demo seeds the labeled synthetic data once into an empty
# store, enables the development login code (no SMTP) and keeps the worker off.
# CAMPUS_CLOUD_MODE=live keeps the app.py public guard (dev-auth forced off),
# registers the configured sources once and runs the embedded worker.
# CAMPUS_PUBLIC_ORIGIN=https://<host> additionally joins the allowed origins.
